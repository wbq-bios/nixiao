# 服务
PORT=3000
API_SECRET=change-me-to-a-long-random-string   # token 签名密钥
ADMIN_TOKEN=change-me-admin-token              # admin 导入接口令牌

# MySQL（与 docker-compose.yml 对应；本机直装 MySQL 则改 localhost）
DB_HOST=mysql
DB_PORT=3306
DB_USER=xiaqi
DB_PASSWORD=xiaqi-pass
DB_NAME=xiaqi

# 微信（可选：配置后 login 换取真实 openid；不配则用 deviceId 模拟）
WX_APPID=
WX_SECRET=
