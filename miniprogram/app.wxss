/* 逆水小助手 · 全局设计 Token 与公共样式（源自原型 v0.13，游戏词全部走内容包） */
page {
  --bg: #F3EFE6;
  --panel: #ECE6D8;
  --card: #FBF9F3;
  --card-hi: #FFFDF8;
  --line: rgba(38, 34, 28, .09);
  --line-hi: rgba(38, 34, 28, .17);
  --txt: #26221A;
  --dim: #5C554A;
  --faint: #6E6555;
  --gold: #A98643;
  --gold-hi: #8F6F2F;
  --gold-dim: rgba(169, 134, 67, .13);
  --c1: #6E7680; --c2: #3F7D52; --c3: #2F6DA8; --c4: #7C50C8; --c5: #96700F;
  --ts: #C4453C; --ta: #B8741F; --tb: #2F6DA8;
  --green: #2DA44E;
  --serif: "Kaiti SC", "STKaiti", KaiTi, "FangSong", serif;
  background: var(--bg);
  color: var(--txt);
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 14px;
}
button { background: none; padding: 0; margin: 0; line-height: inherit; font-size: inherit; color: inherit; }
button::after { border: none; }

/* ---- 通用布局 ---- */
.page { padding: 12rpx 32rpx calc(160rpx + env(safe-area-inset-bottom)); }
@keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
.rise { animation: rise .5s ease-out both; }

.masthead { padding: 8rpx 4rpx 4rpx; }
.masthead .h1 { font-family: var(--serif); font-weight: 700; font-size: 60rpx; letter-spacing: .1em; text-shadow: 0 1rpx 0 rgba(143, 111, 47, .28); }
.masthead .h1 .em { color: var(--gold-hi); }
.masthead .sub { font-size: 24rpx; color: var(--faint); margin-top: 6rpx; display: flex; gap: 20rpx; }
.masthead .sub .b { color: var(--dim); font-weight: 600; }
.demo-badge { position: absolute; top: 10rpx; right: 0; font-size: 19rpx; padding: 4rpx 14rpx; border-radius: 99rpx; border: 1px solid var(--line-hi); background: var(--card); color: var(--faint); letter-spacing: .08em; }
.hot-badge { position: absolute; top: -12rpx; left: 24rpx; z-index: 2; font-size: 20rpx; font-weight: 700; padding: 5rpx 18rpx; border-radius: 99rpx; background: var(--gold); color: #FFF9EE; letter-spacing: .12em; box-shadow: 0 4rpx 12rpx -4rpx rgba(143,111,47,.5); }

.sec-head { display: flex; align-items: baseline; margin: 44rpx 4rpx 20rpx; }
.sec-head .h2 { font-family: var(--serif); font-size: 34rpx; font-weight: 700; letter-spacing: .08em; }
.sec-head .more { margin-left: auto; font-size: 22rpx; color: var(--gold-hi); }
.blk { display: flex; align-items: center; gap: 14rpx; margin: 32rpx 4rpx 18rpx; }
.blk::before { content: ""; width: 7rpx; height: 30rpx; border-radius: 4rpx; background: var(--gold); }
.blk .bt { font-family: var(--serif); font-size: 31rpx; letter-spacing: .04em; font-weight: 700; }
.blk .cnt { font-size: 20rpx; padding: 5rpx 14rpx; border-radius: 14rpx; background: var(--gold-dim); color: var(--gold-hi); }
.blk .ops { margin-left: auto; display: flex; gap: 22rpx; font-size: 24rpx; color: var(--dim); }

.card { background: var(--card); border: 1px solid var(--line); border-radius: 32rpx; padding: 28rpx; margin-bottom: 22rpx; box-shadow: 0 4rpx 18rpx -10rpx rgba(58,50,38,.16); }

/* ---- chips / 分段 ---- */
.chiprow { display: flex; gap: 14rpx; overflow-x: auto; white-space: nowrap; margin: 0 -32rpx; padding: 2rpx 32rpx 8rpx; }
.chip { flex: none; height: 72rpx; line-height: 68rpx; padding: 0 28rpx; border-radius: 99rpx; border: 1px solid var(--line-hi); color: var(--dim); font-size: 25rpx; background: var(--card); display: inline-block; }
.chip.on { background: var(--gold-dim); border-color: rgba(169,134,67,.55); color: var(--gold-hi); font-weight: 650; }
.chip.sm { height: 62rpx; line-height: 58rpx; }

.slider-seg { position: relative; display: flex; background: var(--card); border: 1px solid var(--line); border-radius: 26rpx; padding: 7rpx; box-shadow: 0 4rpx 18rpx -10rpx rgba(58,50,38,.16); }
.slider-seg .thumb { position: absolute; top: 7rpx; bottom: 7rpx; width: calc(50% - 7rpx); background: #E4D9BE; border-radius: 18rpx; transition: transform .34s ease; }
.slider-seg .opt { position: relative; z-index: 1; flex: 1; height: 80rpx; line-height: 80rpx; text-align: center; color: var(--dim); font-size: 27rpx; font-weight: 600; }
.slider-seg .opt.on { color: #6B5426; font-weight: 700; }

.seg { display: flex; background: var(--panel); border: 1px solid var(--line); border-radius: 22rpx; padding: 5rpx; margin: 6rpx 0 20rpx; }
.seg .opt { flex: 1; height: 72rpx; line-height: 72rpx; text-align: center; border-radius: 16rpx; font-size: 27rpx; color: var(--dim); }
.seg .opt.on { background: var(--card); color: var(--gold-hi); font-weight: 650; }

.search { display: flex; align-items: center; height: 80rpx; background: var(--card); border: 1px solid var(--line-hi); border-radius: 22rpx; padding: 0 26rpx; margin-bottom: 20rpx; }
.search input { flex: 1; font-size: 27rpx; color: var(--txt); margin-left: 14rpx; }

/* ---- 徽标 / 标签 ---- */
.tier { display: inline-grid; place-items: center; width: 42rpx; height: 42rpx; border-radius: 11rpx; font-size: 24rpx; font-weight: 800; color: #FFF6EC; }
.tier.S { background: var(--ts); } .tier.A { background: var(--ta); } .tier.B { background: var(--tb); }
.badge { font-size: 20rpx; font-weight: 700; padding: 5rpx 14rpx; border-radius: 11rpx; background: var(--gold-dim); color: var(--gold-hi); border: 1px solid rgba(169,134,67,.35); }
.badge.solid { background: var(--gold); color: #FFF6EC; border-color: transparent; }
.tag { display: inline-block; white-space: nowrap; font-size: 21rpx; padding: 5rpx 14rpx; border-radius: 11rpx; background: var(--panel); color: var(--dim); border: 1px solid var(--line); margin-right: 8rpx; }
.tag.gold { background: var(--gold-dim); color: var(--gold-hi); border-color: rgba(169,134,67,.3); }
.cost { font-size: 21rpx; font-weight: 700; }
.cost::before { content: "◆"; font-size: 15rpx; margin-right: 4rpx; }
.rar { font-size: 20rpx; padding: 3rpx 12rpx; border-radius: 9rpx; }
/* 品阶类名用 ASCII(中文类名过不了 wxss 编译),映射见 core/format.js rarCls */
.rar.r-bai { background: rgba(110,118,128,.14); color: #5B636D; }
.rar.r-zi { background: rgba(124,80,200,.13); color: #6E46B8; }
.rar.r-duzhen { background: rgba(47,109,168,.13); color: #2A6392; }
.rar.r-chengwu { background: rgba(169,134,67,.18); color: #8F6F2F; }

/* ---- 印章头像 / 棋子格 ---- */
.ava { display: inline-grid; place-items: center; width: 80rpx; height: 80rpx; border-radius: 50%; font-family: var(--serif); font-size: 34rpx; font-weight: 700; }
.ava.main { box-shadow: 0 0 0 4rpx var(--card), 0 0 0 7rpx var(--gold); }
.units { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22rpx 14rpx; }
.unit { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.u-box { position: relative; width: 100%; height: 0; padding-bottom: 100%; border-radius: 18rpx; border: 5rpx solid; display: grid; place-items: center; font-family: var(--serif); font-size: 44rpx; font-weight: 700; }
.u-box .inner { position: absolute; top: 0; left: 0; right: 0; bottom: 0; display: grid; place-items: center; }
.u-box .stars { position: absolute; top: 6rpx; left: 0; right: 0; text-align: center; font-size: 17rpx; color: #E7A93C; letter-spacing: -2rpx; text-shadow: 0 0 3rpx #FBF9F3, 0 0 4rpx #FBF9F3; }
.u-box .cmark { position: absolute; top: -12rpx; left: -12rpx; width: 36rpx; height: 36rpx; border-radius: 50%; background: #E0862F; color: #FFF6EC; font-size: 21rpx; font-weight: 800; display: grid; place-items: center; border: 4rpx solid var(--card); }
.u-box .items { position: absolute; bottom: 5rpx; left: 0; right: 0; display: flex; justify-content: center; gap: 4rpx; }
.u-box .items .it { width: 27rpx; height: 27rpx; border-radius: 7rpx; background: var(--card); border: 1px solid var(--line-hi); font-size: 17rpx; font-family: var(--serif); display: grid; place-items: center; color: var(--dim); font-weight: 400; }
.unit .u-name { font-size: 21rpx; color: var(--dim); max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.u-mini { position: relative; display: inline-grid; place-items: center; width: 100%; height: 0; padding-bottom: 100%; border-radius: 12rpx; border: 3rpx solid; font-family: var(--serif); font-weight: 700; }
.u-mini .inner { position: absolute; top: 0; left: 0; right: 0; bottom: 0; display: grid; place-items: center; }
.u-mini .cmark { position: absolute; top: -8rpx; left: -8rpx; width: 30rpx; height: 30rpx; border-radius: 50%; background: #E0862F; color: #FFF6EC; font-size: 18rpx; font-weight: 800; display: grid; place-items: center; }

/* ---- 羁绊胶囊 ---- */
.traits { display: flex; flex-wrap: wrap; gap: 14rpx; }
.trait { display: inline-flex; align-items: center; gap: 10rpx; padding: 7rpx 18rpx 7rpx 9rpx; border-radius: 99rpx; background: var(--card); border: 1px solid var(--line-hi); font-size: 24rpx; color: var(--dim); }
.trait .ic { position: relative; width: 44rpx; height: 44rpx; border-radius: 11rpx; background: var(--panel); border: 1px solid var(--line-hi); display: grid; place-items: center; font-family: var(--serif); font-size: 24rpx; color: var(--dim); }
.trait .ct { position: absolute; right: -11rpx; bottom: -11rpx; min-width: 28rpx; height: 28rpx; padding: 0 5rpx; border-radius: 99rpx; background: #3A342B; color: #F5F1E6; font-size: 18rpx; font-weight: 700; display: grid; place-items: center; }
.trait .pg { font-size: 20rpx; color: var(--faint); font-weight: 600; }
.trait.color { border-color: rgba(169,134,67,.5); background: var(--gold-dim); color: var(--gold-hi); font-weight: 650; }
.trait.color .ic { background: linear-gradient(140deg, #D8B56A, #A98643); border-color: transparent; color: #FFF6EC; }
.trait.color .ct { background: var(--gold-hi); }
.trait.dim { opacity: .45; }

/* ---- 赛季入口行 ---- */
.season-bar { width: 100%; display: flex; align-items: center; gap: 18rpx; background: var(--card); border: 1px solid var(--line); border-radius: 26rpx; padding: 28rpx 30rpx; box-shadow: 0 4rpx 18rpx -10rpx rgba(58,50,38,.16); }
.season-bar .nm { font-family: var(--serif); font-size: 31rpx; letter-spacing: .04em; font-weight: 700; }
.season-bar .curbadge { margin-left: 14rpx; font-size: 21rpx; font-weight: 500; opacity: .8; color: var(--gold-hi); letter-spacing: normal; font-family: initial; }
.season-bar .sw { margin-left: auto; color: var(--gold-hi); font-size: 25rpx; font-weight: 600; display: flex; align-items: center; }
.season-bar .sw::after { content: "›"; margin-left: 6rpx; font-size: 30rpx; }

/* ---- 广告位 ---- */
.ad { height: 140rpx; margin: 26rpx 0; border-radius: 24rpx; border: 2rpx dashed rgba(169,134,67,.45); background: repeating-linear-gradient(135deg, rgba(169,134,67,.06) 0 18rpx, transparent 18rpx 36rpx); display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--faint); }
.ad .t1 { font-size: 24rpx; letter-spacing: .2em; }
.ad .t2 { font-size: 19rpx; opacity: .75; margin-top: 4rpx; }

/* ---- 底部弹层 / 遮罩 ---- */
.scrim { position: fixed; inset: 0; z-index: 70; background: rgba(30,26,18,.38); opacity: 0; pointer-events: none; transition: opacity .25s ease; }
.scrim.on { opacity: 1; pointer-events: auto; }
.sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 71; background: #FFFDF8; border-radius: 50rpx 50rpx 0 0; padding: 22rpx 40rpx calc(40rpx + env(safe-area-inset-bottom)); transform: translateY(103%); transition: transform .4s cubic-bezier(.32,.86,.28,1); max-height: 86%; overflow-y: auto; box-shadow: 0 -30rpx 80rpx -30rpx rgba(58,50,38,.4); }
.sheet.on { transform: none; }
.sheet .grab { width: 76rpx; height: 7rpx; border-radius: 99rpx; background: rgba(38,34,28,.18); margin: 0 auto 26rpx; }
.sheet .h3 { font-family: var(--serif); font-size: 34rpx; letter-spacing: .05em; }
.sheet .sp { font-size: 22rpx; color: #8A8375; margin: 6rpx 0 24rpx; }
.sheet .pcount { position: absolute; right: 40rpx; top: 30rpx; font-size: 22rpx; color: #8A8375; }

/* ---- 居中弹窗 ---- */
.modal-mask { position: fixed; inset: 0; z-index: 80; background: rgba(30,26,18,.46); display: flex; align-items: center; justify-content: center; opacity: 0; pointer-events: none; transition: opacity .25s ease; }
.modal-mask.on { opacity: 1; pointer-events: auto; }
.modal { width: 86%; max-height: 82%; overflow-y: auto; background: #FFFDF8; border-radius: 36rpx; padding: 30rpx; transform: scale(.94); transition: transform .28s ease; }
.modal-mask.on .modal { transform: none; }
.mtop { display: flex; align-items: center; margin-bottom: 24rpx; }
.mtop .h3 { font-size: 32rpx; font-weight: 800; }
.mtop .x { margin-left: auto; width: 72rpx; height: 72rpx; display: grid; place-items: center; color: var(--faint); font-size: 34rpx; }
.mcard { background: #F6F2E7; border-radius: 24rpx; padding: 22rpx; margin-top: 22rpx; }
.mcard .t { font-size: 23rpx; font-weight: 700; margin-bottom: 14rpx; }
.mcard .t .hint { font-weight: 400; font-size: 19rpx; color: var(--faint); margin-left: 10rpx; }
.mrow { display: flex; gap: 18rpx; margin-top: 26rpx; }
.btn-rm { flex: 1; height: 84rpx; line-height: 84rpx; text-align: center; border-radius: 24rpx; background: #F6E3DC; color: #B04A3E; font-weight: 700; font-size: 26rpx; }
.btn-ok { flex: 2; height: 84rpx; line-height: 84rpx; text-align: center; border-radius: 24rpx; background: var(--gold); color: #FFF9EE; font-weight: 700; font-size: 26rpx; }

/* ---- 开关 ---- */
.tgl-wrap { display: flex; align-items: center; gap: 14rpx; }
.tgl-wrap .lb { font-size: 23rpx; color: var(--gold-hi); font-weight: 650; }
.tgl { width: 80rpx; height: 46rpx; border-radius: 99rpx; background: #D8D2C4; position: relative; transition: background .2s; }
.tgl::after { content: ""; position: absolute; top: 5rpx; left: 5rpx; width: 36rpx; height: 36rpx; border-radius: 50%; background: #FFFDF8; transition: left .2s; box-shadow: 0 2rpx 5rpx rgba(0,0,0,.2); }
.tgl.on { background: var(--gold); }
.tgl.on::after { left: 39rpx; }

/* ---- 赞踩 ---- */
.votes { display: flex; align-items: center; gap: 14rpx; margin-top: 18rpx; }
.votes .hint { font-size: 19rpx; color: var(--faint); margin-right: auto; white-space: nowrap; }
.vote { display: inline-flex; align-items: center; justify-content: center; gap: 8rpx; min-width: 96rpx; height: 64rpx; padding: 0 22rpx; border-radius: 99rpx; border: 1px solid var(--line-hi); background: var(--card); color: var(--dim); font-size: 23rpx; font-weight: 650; }
.vote.on { background: var(--gold-dim); border-color: rgba(169,134,67,.55); color: var(--gold-hi); }
.vote.down.on { background: rgba(196,69,60,.1); border-color: rgba(196,69,60,.4); color: var(--ts); }
.vote.zero { opacity: .68; }

/* ---- 其他 ---- */
.empty { border: 2rpx dashed var(--line-hi); border-radius: 32rpx; padding: 54rpx 36rpx; text-align: center; color: var(--faint); font-size: 24rpx; line-height: 1.7; }
.empty .k { font-family: var(--serif); font-size: 29rpx; color: var(--dim); display: block; margin-bottom: 8rpx; }
.legal { font-size: 21rpx; color: var(--faint); line-height: 1.8; text-align: center; margin-top: 40rpx; }
.savebtn { width: 100%; height: 90rpx; line-height: 90rpx; text-align: center; border-radius: 26rpx; margin-top: 8rpx; background: var(--gold); color: #FFF9EE; font-size: 28rpx; font-weight: 700; }
.odds { width: 100%; border-collapse: collapse; font-size: 24rpx; }
.odds th { font-size: 21rpx; color: var(--faint); font-weight: 600; text-align: right; padding: 14rpx 10rpx; border-bottom: 1px solid var(--line); }
.odds td { padding: 17rpx 10rpx; text-align: right; border-bottom: 1px solid var(--line); color: var(--dim); }
.odds th:first-child, .odds td:first-child { text-align: left; }
.odds .lvl { color: var(--gold-hi); font-weight: 700; font-family: var(--serif); }
.odds .hot { color: var(--txt); font-weight: 650; }
.tl { list-style: none; }
.tl .li { position: relative; padding: 0 0 36rpx 36rpx; }
.tl .li::before { content: ""; position: absolute; left: 5rpx; top: 14rpx; width: 13rpx; height: 13rpx; border-radius: 50%; background: var(--gold); }
.tl .li::after { content: ""; position: absolute; left: 11rpx; top: 36rpx; bottom: 0; width: 1px; background: var(--line-hi); }
.tl .li:last-child::after { display: none; }
.tl .tlt { font-size: 21rpx; color: var(--gold-hi); letter-spacing: .08em; }
.tl .p { font-size: 25rpx; color: var(--dim); margin-top: 5rpx; line-height: 1.55; }
.beats .li { display: flex; gap: 20rpx; padding: 16rpx 0; border-bottom: 1px solid var(--line); font-size: 25rpx; color: var(--dim); line-height: 1.65; }
.beats .li:last-child { border-bottom: none; }
.beats .tm { flex: none; font-family: var(--serif); color: var(--gold-hi); font-weight: 700; width: 82rpx; }

/* ---- 下拉选择（选棋弹窗 职业/羁绊，源自原型 .ddrow/.ddpanel） ---- */
.ddrow { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.dd { flex: 1; height: 80rpx; line-height: 76rpx; border: 1px solid var(--line-hi); border-radius: 20rpx; background: var(--card); display: flex; align-items: center; justify-content: center; gap: 12rpx; font-size: 26rpx; color: var(--dim); }
.dd.on { color: var(--gold-hi); border-color: rgba(169,134,67,.55); background: var(--gold-dim); font-weight: 650; }
.dd .ar { font-size: 18rpx; opacity: .6; }
.ddpanel { display: none; }
.ddpanel.open { display: flex; flex-wrap: wrap; gap: 12rpx; margin: -4rpx 0 20rpx; max-height: 220rpx; overflow-y: auto; }
.ddpanel .chip { height: 64rpx; line-height: 60rpx; padding: 0 24rpx; font-size: 24rpx; }

/* ---- 赛季弹层列表 / 首页快捷入口 / 概率表单元格 ---- */
.season-item { width: 100%; display: flex; align-items: center; gap: 20rpx; padding: 30rpx 28rpx; border-radius: 26rpx; border: 3rpx solid var(--line); background: #FFFFFF; margin-bottom: 18rpx; box-sizing: border-box; }
.season-item.on { background: #F3E9CF; border-color: rgba(169,134,67,.65); }
.season-item.on .nm { color: #6B5426; }
.season-item.on .meta { color: #8F6F2F; }
.qk { display: flex; flex-direction: column; align-items: center; gap: 12rpx; padding: 24rpx 6rpx 20rpx; background: var(--card); border: 1px solid var(--line); border-radius: 26rpx; font-size: 22rpx; color: var(--dim); box-shadow: 0 4rpx 18rpx -10rpx rgba(58,50,38,.16); }
.qk-hover { transform: scale(.96); background: var(--gold-dim); }
.qk .qi { width: 62rpx; height: 62rpx; border-radius: 50%; background: var(--gold-dim); color: var(--gold-hi); display: grid; place-items: center; font-family: var(--serif); font-size: 30rpx; font-weight: 700; }
.odds .th { font-size: 21rpx; color: var(--faint); font-weight: 600; padding: 14rpx 8rpx; }
.odds .td { font-size: 24rpx; color: var(--dim); padding: 16rpx 8rpx; text-align: right; }
.odds .td.lvl { color: var(--gold-hi); font-weight: 700; font-family: var(--serif); text-align: left; }
.odds .td.hot { color: var(--txt); font-weight: 650; }
