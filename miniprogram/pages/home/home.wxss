/* 首页 · 按设计稿(品牌头/搜索/Hero/5快捷/今日推荐/热门阵容) */
.home { min-height: 100vh; background: linear-gradient(180deg, #F6F1E6 0%, var(--bg) 30%); padding-left: 24rpx; padding-right: 24rpx; padding-bottom: calc(140rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }

/* ---- 品牌头 ---- */
.brand { display: flex; align-items: flex-start; gap: 16rpx; padding: 12rpx 4rpx 8rpx; }
.brand-l { flex: 1; min-width: 0; }
.brand-logo { font-family: var(--serif); font-size: 52rpx; font-weight: 700; letter-spacing: .06em; color: var(--txt); position: relative; display: inline-block; }
.brand-seal { position: absolute; top: -6rpx; right: -52rpx; font-family: initial; font-size: 18rpx; line-height: 1; padding: 6rpx 6rpx; background: #C4453C; color: #FFF6EC; border-radius: 8rpx; letter-spacing: 0; }
.brand-slogan { font-size: 21rpx; color: var(--gold-hi); letter-spacing: .22em; margin-top: 2rpx; }
.season-row { display: flex; justify-content: flex-end; padding: 0 4rpx; margin-top: -6rpx; }
.season-pill { max-width: 60%; height: 60rpx; line-height: 60rpx; padding: 0 26rpx; border-radius: 99rpx; background: var(--card); border: 1px solid var(--line-hi); font-size: 23rpx; color: var(--dim); box-shadow: 0 4rpx 14rpx -8rpx rgba(58,50,38,.2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pill-arrow { font-size: 19rpx; opacity: .7; }

/* ---- 全局搜索 ---- */
.gsearch { display: flex; align-items: center; gap: 12rpx; height: 80rpx; margin-top: 16rpx; padding: 0 28rpx; border-radius: 99rpx; background: var(--card); border: 1px solid var(--line-hi); }
.gs-icon { font-size: 30rpx; color: var(--faint); }
.gs-ph { font-size: 25rpx; color: #B4AC99; }

/* ---- Hero 轮播 ---- */
.hero { height: 300rpx; margin-top: 20rpx; border-radius: 28rpx; overflow: hidden; }
.hero-card { position: relative; width: 100%; height: 100%; }
.hero-art { position: absolute; inset: 0; width: 100%; height: 100%; }
.hero-shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(38,34,26,.72) 0%, rgba(38,34,26,.28) 55%, rgba(38,34,26,0) 100%); }
.hero-copy { position: absolute; left: 40rpx; top: 50%; transform: translateY(-50%); color: #FFF6EC; }
.hero-title { font-family: var(--serif); font-size: 46rpx; font-weight: 700; letter-spacing: .1em; text-shadow: 0 2rpx 8rpx rgba(0,0,0,.4); }
.hero-sub { font-size: 23rpx; opacity: .92; margin-top: 10rpx; max-width: 420rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.hero-btn { display: inline-block; margin-top: 20rpx; padding: 10rpx 30rpx; border-radius: 99rpx; background: rgba(169,134,67,.92); font-size: 24rpx; font-weight: 650; }

/* ---- 5 快捷入口 ---- */
.quicks { display: grid; grid-template-columns: repeat(5, 1fr); gap: 14rpx; margin-top: 22rpx; }
.qk5 { background: var(--card); border: 1px solid var(--line); border-radius: 22rpx; padding: 20rpx 4rpx 16rpx; text-align: center; box-shadow: 0 4rpx 14rpx -10rpx rgba(58,50,38,.14); }
.qk5-hover { transform: scale(.95); }
.qk5-icon { width: 72rpx; height: 72rpx; margin: 0 auto 10rpx; border-radius: 50%; background: var(--gold-dim); color: var(--gold-hi); font-family: var(--serif); font-size: 32rpx; font-weight: 700; display: grid; place-items: center; }
.qk5-n { font-size: 23rpx; font-weight: 650; color: var(--txt); }
.qk5-d { font-size: 18rpx; color: var(--faint); margin-top: 3rpx; transform: scale(.9); }

/* ---- 区块标题行 ---- */
.blk-row { display: flex; align-items: center; gap: 12rpx; margin: 36rpx 4rpx 18rpx; }
.blk-row.hot { margin-top: 30rpx; }
.blk-t { font-family: var(--serif); font-size: 34rpx; font-weight: 700; letter-spacing: .05em; }
.blk-flame { font-size: 28rpx; }
.blk-more { margin-left: auto; font-size: 22rpx; color: var(--faint); }

/* ---- 阵容信息流卡 ---- */
.feed-card { position: relative; background: var(--card); border: 1px solid var(--line); border-radius: 24rpx; padding: 22rpx 24rpx 20rpx; margin-bottom: 22rpx; box-shadow: 0 4rpx 16rpx -10rpx rgba(58,50,38,.15); }
.feed-card.big { border-color: rgba(169,134,67,.4); }
.fc-head { display: flex; align-items: flex-start; gap: 12rpx; margin-bottom: 16rpx; }
.fc-mark { flex: none; width: 40rpx; height: 40rpx; border-radius: 50%; background: var(--gold-dim); color: var(--gold-hi); display: grid; place-items: center; font-size: 22rpx; }
.fc-name { flex: 1; min-width: 0; font-family: var(--serif); font-size: 30rpx; font-weight: 700; line-height: 1.35; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; overflow-wrap: anywhere; }
.fc-acts { flex: none; display: flex; align-items: center; gap: 12rpx; }
.fc-author { max-width: 176rpx; font-size: 20rpx; color: var(--faint); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.fc-star { width: 64rpx; height: 64rpx; display: grid; place-items: center; font-size: 34rpx; color: var(--gold-hi); background: var(--gold-dim); border-radius: 50%; }
.fc-star.on { color: #D99535; }

/* 成员条:全员统一方形格,费用色边框,头像裁剪,装备小格贴底(参考金铲铲样式) */
.fc-units { margin-top: 4rpx; }
.fc-strip { display: block; white-space: nowrap; overflow-x: auto; }
.fc-unit { position: relative; display: inline-block; vertical-align: top; width: 104rpx; height: 104rpx; margin-right: 12rpx; border: 3rpx solid var(--line-hi); border-radius: 14rpx; overflow: hidden; background: var(--panel); box-sizing: border-box; }
.fc-unit-img { position: absolute; inset: 0; width: 100%; height: 100%; }
.fc-cbadge { position: absolute; top: 0; left: 0; z-index: 3; font-size: 17rpx; padding: 2rpx 10rpx; background: #D99535; color: #FFF9EE; border-radius: 0 0 12rpx 0; font-weight: 700; }
.fc-unit-star { position: absolute; top: 2rpx; left: 0; right: 0; z-index: 2; text-align: center; font-size: 15rpx; color: #FFE9B8; text-shadow: 0 0 4rpx rgba(0,0,0,.75); }
.fc-items { position: absolute; left: 3rpx; right: 3rpx; bottom: 3rpx; z-index: 2; display: flex; gap: 3rpx; }
.fc-item { flex: 1; height: 24rpx; font-family: var(--serif); font-size: 15rpx; line-height: 24rpx; text-align: center; background: rgba(38,34,26,.8); color: #FFE9B8; border-radius: 5rpx; }
.fc-arrow { display: none; }

.fc-traits { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 14rpx; }
.fpill { display: inline-flex; align-items: center; gap: 10rpx; padding: 6rpx 18rpx 6rpx 6rpx; border-radius: 14rpx; border: 1px solid; background: #FFFDF8; }
.fpill-icon { width: 40rpx; height: 40rpx; border-radius: 10rpx; background: var(--panel) center/cover; }
.fpill-n { font-size: 21rpx; font-weight: 650; }

/* ---- 速览弹层(侠客/羁绊) ---- */
.modal.pop { width: 86%; padding-bottom: 30rpx; }
.pop-head { display: flex; gap: 20rpx; }
.pop-art { flex: none; width: 144rpx; height: 180rpx; border-radius: 16rpx; background: var(--panel); }
.pop-info { flex: 1; min-width: 0; }
.pop-name { font-family: var(--serif); font-size: 34rpx; font-weight: 700; }
.pop-cost { font-size: 24rpx; font-weight: 700; margin-left: 6rpx; }
.pop-job { font-size: 22rpx; color: var(--faint); margin-top: 8rpx; }
.pop-bonds { margin-top: 12rpx; display: flex; flex-wrap: wrap; gap: 8rpx; }
.pop-skill { margin-top: 18rpx; background: #F6F2E7; border-radius: 16rpx; padding: 18rpx; max-height: 280rpx; overflow-y: auto; }
.pop-skill-n { font-size: 24rpx; font-weight: 700; color: var(--gold-hi); margin-bottom: 8rpx; }
.pop-skill-d { font-size: 23rpx; color: var(--dim); line-height: 1.7; }
.pop-btns { display: flex; gap: 16rpx; margin-top: 22rpx; }
.pop-btn { flex: 1; height: 76rpx; line-height: 76rpx; text-align: center; border-radius: 20rpx; background: var(--gold); color: #FFF9EE; font-size: 25rpx; font-weight: 700; }
.pop-btn.ghost { background: var(--panel); color: var(--dim); }

.legal { text-align: center; font-size: 20rpx; color: var(--faint); padding: 26rpx 0 10rpx; }
