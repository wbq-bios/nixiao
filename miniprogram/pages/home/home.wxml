<view class="home" style="padding-top:{{statusH}}px">

  <!-- 品牌头 + 赛季胶囊(胶囊按钮占右上,赛季胶囊下移一行避让) -->
  <view class="brand">
    <view class="brand-l">
      <view class="brand-logo">逆水侠棋<text class="brand-seal">手游</text></view>
      <view class="brand-slogan">—— 侠客为棋 · 江湖为局 ——</view>
    </view>
  </view>
  <view class="season-row">
    <button class="season-pill" bindtap="onSeasonBar">当前赛季：{{season.id}} {{season.name}} <text class="pill-arrow">∨</text></button>
  </view>

  <!-- 全局搜索 -->
  <view class="gsearch" bindtap="onSearch">
    <text class="gs-icon">⌕</text>
    <text class="gs-ph">搜索侠客、羁绊、装备、阵容...</text>
  </view>

  <!-- Hero 轮播:版本强势阵容 -->
  <swiper class="hero" autoplay circular interval="4500" indicator-dots indicator-color="rgba(255,253,248,.5)" indicator-active-color="#FFFDF8">
    <swiper-item wx:for="{{banners}}" wx:key="n">
      <view class="hero-card" data-name="{{item.n}}" data-season="{{item.season}}" bindtap="onBannerTap">
        <image class="hero-art" src="{{item.mainArt}}" mode="aspectFill" />
        <view class="hero-shade"></view>
        <view class="hero-copy">
          <view class="hero-title">版本强势阵容</view>
          <view class="hero-sub">{{item.n}}</view>
          <view class="hero-btn">查看详情 →</view>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <!-- 5 快捷入口 -->
  <view class="quicks">
    <view wx:for="{{quills}}" wx:key="n" class="qk5" hover-class="qk5-hover" data-i="{{index}}" bindtap="onQuick">
      <view class="qk5-icon">{{item.icon}}</view>
      <view class="qk5-n">{{item.n}}</view>
      <view class="qk5-d">{{item.d}}</view>
    </view>
  </view>

  <!-- 今日推荐 -->
  <view class="blk-row" wx:if="{{today}}">
    <text class="blk-t">今日推荐</text>
    <text class="blk-more" bindtap="onMore">查看更多 ›</text>
  </view>
  <view wx:if="{{today}}" class="feed-card big" data-name="{{today.n}}" data-season="{{today.season}}" bindtap="onCompTap">
    <view class="fc-head">
      <view class="fc-mark">✦</view>
      <text class="fc-name">{{today.n}}</text>
      <view class="fc-acts">
        <text class="fc-author">{{today.author}}</text>
        <view class="fc-star {{favs[today.n] ? 'on' : ''}}" catchtap="onFav" data-name="{{today.n}}" data-season="{{today.season}}">{{favs[today.n] ? "★" : "☆"}}</view>
      </view>
    </view>
    <scroll-view class="fc-strip" scroll-x enhanced show-scrollbar="{{false}}">
      <view wx:for="{{today.units}}" wx:key="n" class="fc-unit" style="border-color:{{item.color}}" catchtap="onUnitTap" data-n="{{item.n}}" data-season="{{today.season}}">
        <view class="fc-unit-img" style="background-image:url('{{item.art}}');background-size:cover;background-position:center 12%"></view>
        <view wx:if="{{item.isMain}}" class="fc-cbadge">主C</view>
        <text class="fc-unit-star">★</text>
        <view wx:if="{{item.items.length}}" class="fc-items">
          <text wx:for="{{item.items}}" wx:for-item="it" wx:key="*this" class="fc-item">{{it[0]}}</text>
        </view>
      </view>
    </scroll-view>
    <view class="fc-traits">
      <view wx:for="{{today.traits}}" wx:key="n" class="fpill" style="border-color:{{item.color}}55" catchtap="onBondTap" data-n="{{item.n}}" data-season="{{today.season}}">
        <image class="fpill-icon" src="{{item.icon}}" mode="aspectFit" />
        <text class="fpill-n" style="color:{{item.color}}">{{item.n}} {{item.count}}</text>
      </view>
    </view>
  </view>

  <!-- 热门阵容 -->
  <view class="blk-row hot">
    <text class="blk-t"><text class="blk-flame">🔥</text> 热门阵容</text>
    <text class="blk-more" bindtap="onMore">查看更多 ›</text>
  </view>
  <view wx:for="{{hotList}}" wx:key="n" class="feed-card" data-name="{{item.n}}" data-season="{{item.season}}" bindtap="onCompTap">
    <view class="fc-head">
      <view class="fc-mark">✦</view>
      <text class="fc-name">{{item.n}}</text>
      <view class="fc-acts">
        <text class="fc-author">{{item.author}}</text>
        <view class="fc-star {{favs[item.n] ? 'on' : ''}}" catchtap="onFav" data-name="{{item.n}}" data-season="{{item.season}}">{{favs[item.n] ? "★" : "☆"}}</view>
      </view>
    </view>
    <scroll-view class="fc-strip" scroll-x enhanced show-scrollbar="{{false}}">
      <view wx:for="{{item.units}}" wx:key="n" wx:for-item="u" class="fc-unit" style="border-color:{{u.color}}" catchtap="onUnitTap" data-n="{{u.n}}" data-season="{{item.season}}">
        <view class="fc-unit-img" style="background-image:url('{{u.art}}');background-size:cover;background-position:center 12%"></view>
        <view wx:if="{{u.isMain}}" class="fc-cbadge">主C</view>
        <text class="fc-unit-star">★</text>
        <view wx:if="{{u.items.length}}" class="fc-items">
          <text wx:for="{{u.items}}" wx:for-item="it" wx:key="*this" class="fc-item">{{it[0]}}</text>
        </view>
      </view>
    </scroll-view>
    <view class="fc-traits">
      <view wx:for="{{item.traits}}" wx:for-item="t" wx:key="n" class="fpill" style="border-color:{{t.color}}55" catchtap="onBondTap" data-n="{{t.n}}" data-season="{{item.season}}">
        <image class="fpill-icon" src="{{t.icon}}" mode="aspectFit" />
        <text class="fpill-n" style="color:{{t.color}}">{{t.n}} {{t.count}}</text>
      </view>
    </view>
  </view>

  <view class="legal">{{season.id}} 赛季 · 内测数据 · 非官方工具,版权归网易所有</view>
</view>

<view class="scrim {{sheetOn ? 'on' : ''}}" bindtap="onScrim"></view>
<view class="sheet {{sheetOn ? 'on' : ''}}">
  <view class="grab"></view>
  <view class="h3">赛季更迭</view>
  <view class="sp">每个赛季棋子与羁绊会更换；归档赛季数据只读可查</view>
  <button wx:for="{{seasons}}" wx:key="id" class="season-item {{season.id === item.id ? 'on' : ''}}" data-id="{{item.id}}" bindtap="onPickSeason" style="text-align:left">
    <view class="info" style="flex:1">
      <view class="nm" style="font-size:30rpx;font-weight:650">{{item.id}} · {{item.name}}</view>
      <view class="rg" style="font-size:21rpx;color:#8A8375;margin-top:4rpx">{{item.range}}</view>
    </view>
    <text class="meta" style="font-size:23rpx;color:#8A8375">{{season.id === item.id ? "当前赛季" : "切换"}}</text>
  </button>
</view>

<!-- 侠客速览弹层 -->
<view class="modal-mask {{popUnit ? 'on' : ''}}" bindtap="onPopClose">
  <view class="modal pop" catchtap="noop">
    <block wx:if="{{popUnit}}">
      <view class="pop-head">
        <view class="pop-art" style="background-image:url('{{popUnit.art}}');background-size:cover;background-position:center 10%"></view>
        <view class="pop-info">
          <view class="pop-name">{{popUnit.n}} <text class="pop-cost" style="color:{{popUnit.color}}">{{popUnit.c}}费</text></view>
          <view class="pop-job">{{popUnit.job}}</view>
          <view class="pop-bonds"><text wx:for="{{popUnit.bonds}}" wx:key="*this" class="tag gold">{{item}}</text></view>
        </view>
      </view>
      <view wx:if="{{popUnit.skill}}" class="pop-skill">
        <view class="pop-skill-n">{{popUnit.skill.n}}</view>
        <view class="pop-skill-d">{{popUnit.skill.d}}</view>
      </view>
      <view class="pop-btns">
        <button class="pop-btn ghost" bindtap="onPopClose">关闭</button>
        <button class="pop-btn" bindtap="onPopDetail" data-type="piece" data-name="{{popUnit.n}}">查看完整详情</button>
      </view>
    </block>
  </view>
</view>

<!-- 羁绊速览弹层 -->
<view class="modal-mask {{popBond ? 'on' : ''}}" bindtap="onPopClose">
  <view class="modal pop" catchtap="noop">
    <block wx:if="{{popBond}}">
      <view class="pop-head">
        <image class="pop-art" src="{{popBond.icon}}" mode="aspectFill" />
        <view class="pop-info">
          <view class="pop-name">{{popBond.n}}</view>
          <view class="pop-job">{{popBond.t}}羁绊 · 激活层数 {{popBond.lv}}</view>
        </view>
      </view>
      <view class="pop-skill">
        <view class="pop-skill-d">{{popBond.d}}</view>
      </view>
      <view class="pop-btns">
        <button class="pop-btn ghost" bindtap="onPopClose">关闭</button>
        <button class="pop-btn" bindtap="onPopDetail" data-type="bond" data-name="{{popBond.n}}">查看完整详情</button>
      </view>
    </block>
  </view>
</view>
