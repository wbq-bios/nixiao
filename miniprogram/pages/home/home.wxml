<view class="home" style="padding-top:{{statusH}}px">

  <!-- 品牌头(logo + 标语) -->
  <view class="brand">
    <view class="brand-l">
      <view class="brand-logo">逆水侠棋<text class="brand-seal">手游</text></view>
      <view class="brand-slogan">—— 侠客为棋 · 江湖为局 ——</view>
    </view>
  </view>
  <!-- 赛季胶囊:设计稿位置——品牌行右侧、紧邻系统胶囊;top/right/可用宽由 onReady 实测菜单按钮下发 -->
  <view hover-class="tap-dim" class="season-pill" style="top:{{pillTop}}px;right:{{pillRight}}px;max-width:{{pillMaxW}}px" bindtap="onSeasonBar">当前赛季：{{season.id}} {{season.name}} <text class="pill-arrow">∨</text></view>

  <!-- 全局搜索 -->
  <view class="gsearch" bindtap="onSearch">
    <text class="gs-icon">⌕</text>
    <text class="gs-ph">搜索侠客、羁绊、装备、阵容...</text>
  </view>

  <!-- Hero 轮播:版本强势阵容 -->
  <swiper class="hero" autoplay circular interval="4500" indicator-dots indicator-color="rgba(255,253,248,.5)" indicator-active-color="#FFFDF8">
    <swiper-item wx:for="{{banners}}" wx:key="n">
      <view class="hero-card" data-name="{{item.n}}" data-season="{{item.season}}" bindtap="onBannerTap">
        <image class="hero-art" src="{{item.mainArt}}" mode="aspectFill" />
        <view class="hero-shade"></view>
        <view class="hero-copy">
          <view class="hero-title">版本强势阵容</view>
          <view class="hero-sub">{{item.n}}</view>
          <view class="hero-btn">查看详情 →</view>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <!-- 5 快捷入口 -->
  <view class="quicks">
    <view wx:for="{{quills}}" wx:key="n" class="qk5" hover-class="qk5-hover" data-i="{{index}}" bindtap="onQuick">
      <view class="qk5-icon"><image class="qk5-img" src="{{item.img}}" mode="aspectFit" /></view>
      <view class="qk5-n">{{item.n}}</view>
      <view class="qk5-d">{{item.d}}</view>
    </view>
  </view>

  <!-- 今日推荐 -->
  <view class="blk-row" wx:if="{{today}}">
    <text class="blk-t">今日推荐</text>
    <text class="blk-more" bindtap="onMore">查看更多 ›</text>
  </view>
  <view wx:if="{{today}}" class="ccard rise" data-name="{{today.n}}" data-season="{{today.season}}" bindtap="onCompTap">
    <view class="chead">
      <view class="ctop t1">TOP1</view>
      <text class="cname">{{today.n}}</text>
      <text class="cfav {{favs[today.n] ? 'on' : ''}}" catchtap="onFav" data-name="{{today.n}}" data-season="{{today.season}}">{{favs[today.n] ? "★" : "☆"}}</text>
      <text class="carrow">›</text>
    </view>
    <view class="cmeta">
      <text class="ctag">{{today.grade}} 级</text>
      <text class="ctag">{{today.pop}} 人口</text>
      <text wx:if="{{today.colorBond}}" class="ctag">彩色羁绊</text>
      <text class="cauthor">{{today.author}}</text>
      <text class="cupd">{{today.updText}}</text>
    </view>
    <view class="cdesc">{{today.desc}}</view>
    <view class="cunits-wrap">
      <scroll-view scroll-x class="cunits" show-scrollbar="{{false}}">
        <view class="cunits-in">
          <view wx:for="{{today.units}}" wx:key="n" class="cunit {{item.isMain ? 'main' : ''}}" style="border-color:{{item.color}}66" catchtap="onUnitTap" data-n="{{item.n}}" data-season="{{today.season}}">
            <view wx:if="{{item.art}}" class="cu-art" style="background-image:url('{{item.art}}')"></view>
            <text wx:else class="cu-ch" style="color:{{item.color}}">{{item.ch}}</text>
            <text wx:if="{{item.isMain}}" class="cu-c">主C</text>
            <text wx:if="{{item.stars}}" class="cu-s">{{item.stars}}</text>
          </view>
        </view>
      </scroll-view>
      <view class="cunits-fade"></view>
    </view>
    <view class="cbonds">
      <view wx:for="{{today.bonds}}" wx:key="n" class="cbond" catchtap="onBondTap" data-n="{{item.n}}" data-season="{{today.season}}">
        <view class="cb-ico" style="background-image:url('{{item.icon}}')"></view>
        <text class="cb-n">{{item.count}} {{item.n}}</text>
      </view>
    </view>
  </view>

  <!-- 热门阵容 -->
  <view class="blk-row hot">
    <text class="blk-t"><text class="blk-flame">🔥</text> 热门阵容</text>
    <text class="blk-more" bindtap="onMore">查看更多 ›</text>
  </view>
  <view wx:for="{{hotList}}" wx:key="n" class="ccard rise" data-name="{{item.n}}" data-season="{{item.season}}" bindtap="onCompTap">
    <view class="chead">
      <view class="cbar"></view>
      <text class="cname">{{item.n}}</text>
      <text class="cfav {{favs[item.n] ? 'on' : ''}}" catchtap="onFav" data-name="{{item.n}}" data-season="{{item.season}}">{{favs[item.n] ? "★" : "☆"}}</text>
      <text class="carrow">›</text>
    </view>
    <view class="cmeta">
      <text class="ctag">{{item.grade}} 级</text>
      <text class="ctag">{{item.pop}} 人口</text>
      <text wx:if="{{item.colorBond}}" class="ctag">彩色羁绊</text>
      <text class="cauthor">{{item.author}}</text>
      <text class="cupd">{{item.updText}}</text>
    </view>
    <view class="cdesc">{{item.desc}}</view>
    <view class="cunits-wrap">
      <scroll-view scroll-x class="cunits" show-scrollbar="{{false}}">
        <view class="cunits-in">
          <view wx:for="{{item.units}}" wx:for-item="u" wx:key="n" class="cunit {{u.isMain ? 'main' : ''}}" style="border-color:{{u.color}}66" catchtap="onUnitTap" data-n="{{u.n}}" data-season="{{item.season}}">
            <view wx:if="{{u.art}}" class="cu-art" style="background-image:url('{{u.art}}')"></view>
            <text wx:else class="cu-ch" style="color:{{u.color}}">{{u.ch}}</text>
            <text wx:if="{{u.isMain}}" class="cu-c">主C</text>
            <text wx:if="{{u.stars}}" class="cu-s">{{u.stars}}</text>
          </view>
        </view>
      </scroll-view>
      <view class="cunits-fade"></view>
    </view>
    <view class="cbonds">
      <view wx:for="{{item.bonds}}" wx:for-item="b" wx:key="n" class="cbond" catchtap="onBondTap" data-n="{{b.n}}" data-season="{{item.season}}">
        <view class="cb-ico" style="background-image:url('{{b.icon}}')"></view>
        <text class="cb-n">{{b.count}} {{b.n}}</text>
      </view>
    </view>
  </view>

  <view class="legal">{{season.id}} 赛季 · 内测数据 · 非官方工具,版权归网易所有</view>
</view>

<view class="scrim {{sheetOn ? 'on' : ''}}" bindtap="onScrim"></view>
<view class="sheet {{sheetOn ? 'on' : ''}}">
  <view class="grab"></view>
  <view class="h3">赛季更迭</view>
  <view class="sp">每个赛季棋子与羁绊会更换；归档赛季数据只读可查</view>
  <view wx:for="{{seasons}}" wx:key="id" class="season-item {{season.id === item.id ? 'on' : ''}}" data-id="{{item.id}}" bindtap="onPickSeason">
    <view class="s-info">
      <view class="s-nm">{{item.id}} · {{item.name}}</view>
      <view class="s-rg">{{item.range}}</view>
    </view>
    <view wx:if="{{season.id === item.id}}" class="s-tag">当前赛季</view>
    <view wx:else class="s-go">切换</view>
  </view>
</view>

<!-- 侠客速览弹层 -->
<view class="modal-mask {{popUnit ? 'on' : ''}}" bindtap="onPopClose">
  <view class="modal pop" catchtap="noop">
    <block wx:if="{{popUnit}}">
      <view class="pop-head">
        <view class="pop-art" style="background-image:url('{{popUnit.art}}');background-size:cover;background-position:center 10%"></view>
        <view class="pop-info">
          <view class="pop-name">{{popUnit.n}} <text class="pop-cost" style="color:{{popUnit.color}}">{{popUnit.c}}费</text></view>
          <view class="pop-job">{{popUnit.job}}</view>
          <view class="pop-bonds"><text wx:for="{{popUnit.bonds}}" wx:key="*this" class="tag gold">{{item}}</text></view>
        </view>
      </view>
      <view wx:if="{{popUnit.skill}}" class="pop-skill">
        <view class="pop-skill-n">{{popUnit.skill.n}}</view>
        <view class="pop-skill-d">{{popUnit.skill.d}}</view>
      </view>
      <view class="pop-btns">
        <view hover-class="tap-dim" class="pop-btn ghost" bindtap="onPopClose">关闭</view>
        <view hover-class="tap-dim" class="pop-btn" bindtap="onPopDetail" data-type="piece" data-name="{{popUnit.n}}">查看完整详情</view>
      </view>
    </block>
  </view>
</view>

<!-- 羁绊速览弹层 -->
<view class="modal-mask {{popBond ? 'on' : ''}}" bindtap="onPopClose">
  <view class="modal pop" catchtap="noop">
    <block wx:if="{{popBond}}">
      <view class="pop-head">
        <view class="pop-art pop-art-sq" style="background-image:url('{{popBond.icon}}');background-size:contain;background-position:center;background-repeat:no-repeat"></view>
        <view class="pop-info">
          <view class="pop-name">{{popBond.n}}</view>
          <view class="pop-job">{{popBond.t}}羁绊 · 激活层数 {{popBond.lv}}</view>
        </view>
      </view>
      <view class="pop-skill">
        <view class="pop-skill-d">{{popBond.d}}</view>
      </view>
      <view class="pop-btns">
        <view hover-class="tap-dim" class="pop-btn ghost" bindtap="onPopClose">关闭</view>
        <view hover-class="tap-dim" class="pop-btn" bindtap="onPopDetail" data-type="bond" data-name="{{popBond.n}}">查看完整详情</view>
      </view>
    </block>
  </view>
</view>
