<view class="page dpage" wx:if="{{d}}">

  <!-- ============ 阵容详情 ============ -->
  <block wx:if="{{type === 'comp'}}">
    <view style="display:flex;gap:24rpx;align-items:center">
      <text class="tier {{d.grade || d.tier}}" style="width:62rpx;height:62rpx;font-size:31rpx;border-radius:18rpx">{{d.grade || d.tier}}</text>
      <view style="flex:1;min-width:0;overflow:hidden">
        <view style="font-family:var(--serif);font-size:41rpx;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{d.n}}</view>
        <view style="font-size:23rpx;color:var(--faint);margin-top:6rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">主C {{d.main}}（{{d.carry}}费） · {{d.pop}} 级成型</view>
      </view>
      <view style="margin-left:auto;display:flex;align-items:center;gap:12rpx">
        <view hover-class="tap-dim" class="vote" bindtap="onFav">{{fav ? "★ 已藏" : "☆ 收藏"}}</view>
        <!-- 使用 = 把整套阵容载入摆棋(?comp=),列表页不再放入口 -->
        <view hover-class="tap-dim" class="usebtn" catchtap="onUse">使用</view>
      </view>
    </view>
    <view style="display:flex;gap:10rpx;flex-wrap:wrap;margin-top:16rpx">
      <text wx:for="{{d.styleTags}}" wx:key="*this" class="tag">{{item}}</text>
      <text class="tag">热度 {{d.up || 0}}</text>
      <text class="tag">更新 {{d.upd}}</text>
      <text wx:if="{{d.colorBond}}" class="tag gold">✦ 彩色羁绊体系</text>
    </view>
    <!-- 点赞:热度 = 点赞数,再点一次取消 -->
    <view style="display:flex;gap:14rpx;margin-top:14rpx">
      <view hover-class="tap-dim" class="vote {{d.my === 'up' ? 'on' : ''}}" catchtap="onVote" data-dir="up">👍 {{d.up || 0}}</view>
      <view hover-class="tap-dim" class="vote down {{d.my === 'down' ? 'on' : ''}}" catchtap="onVote" data-dir="down">👎 {{d.down || 0}}</view>
    </view>
    <view class="traits" style="margin-top:18rpx">
      <view wx:for="{{d.traitsVM}}" wx:key="n" class="trait {{item.color ? 'color' : ''}}">
        <view class="ic {{item.icon ? 'img' : ''}}">
          <view wx:if="{{item.icon}}" class="ic-ico" style="background-image:url('{{item.icon}}')"></view>
          <text wx:else>{{item.ch}}</text>
          <text class="ct">{{item.count}}</text>
        </view>{{item.count}} {{item.n}}
      </view>
    </view>

    <view class="blk"><text class="bt">阵容构成</text><text class="cnt">主C金圈标出</text></view>
    <view class="card" style="padding:20rpx">
      <view style="display:flex;justify-content:space-between;font-size:19rpx;color:var(--faint);letter-spacing:.18em;margin-bottom:10rpx">
        <text>上 · 后排输出</text><text>下 · 前排承伤</text>
      </view>
      <view class="units" style="margin-top:12rpx" wx:if="{{d.back.length}}">
        <view wx:for="{{d.back}}" wx:key="n" class="unit">
          <view class="u-box" style="border-color:{{item.color}}9a;background:{{item.color}}17;color:{{item.color}}">
            <view class="inner">
              <!-- 立绘优先,没图回退首字 -->
              <view wx:if="{{item.art}}" class="u-art" style="background-image:url('{{item.art}}')"></view>
              <text wx:else>{{item.ch}}</text>
              <view wx:if="{{item.stars}}" class="stars">{{item.stars}}</view>
              <view wx:if="{{item.isMain}}" class="cmark">C</view>
              <view wx:if="{{item.items.length}}" class="items">
                <view wx:for="{{item.items}}" wx:for-item="it" wx:key="name" class="it">
                  <view wx:if="{{it.icon}}" class="it-ico" style="background-image:url('{{it.icon}}')"></view>
                  <text wx:else>{{it.ch}}</text>
                </view>
              </view>
            </view>
          </view>
          <text class="u-name">{{item.n}}</text>
        </view>
      </view>
      <view class="units" style="margin-top:24rpx" wx:if="{{d.front.length}}">
        <view wx:for="{{d.front}}" wx:key="n" class="unit">
          <view class="u-box" style="border-color:{{item.color}}9a;background:{{item.color}}17;color:{{item.color}}">
            <view class="inner">
              <view wx:if="{{item.art}}" class="u-art" style="background-image:url('{{item.art}}')"></view>
              <text wx:else>{{item.ch}}</text>
              <view wx:if="{{item.stars}}" class="stars">{{item.stars}}</view>
              <view wx:if="{{item.isMain}}" class="cmark">C</view>
              <view wx:if="{{item.items.length}}" class="items">
                <view wx:for="{{item.items}}" wx:for-item="it" wx:key="name" class="it">
                  <view wx:if="{{it.icon}}" class="it-ico" style="background-image:url('{{it.icon}}')"></view>
                  <text wx:else>{{it.ch}}</text>
                </view>
              </view>
            </view>
          </view>
          <text class="u-name">{{item.n}}</text>
        </view>
      </view>
    </view>

    <view class="blk" wx:if="{{d.eq.length}}"><text class="bt">核心装备</text></view>
    <view wx:for="{{d.eq}}" wx:key="index" style="display:flex;gap:18rpx;padding:14rpx 4rpx">
      <view style="flex:none;width:40rpx;height:40rpx;border-radius:50%;border:1px solid rgba(169,134,67,.4);color:var(--gold-hi);font-size:21rpx;display:grid;place-items:center">◈</view>
      <view><view style="font-size:26rpx;font-weight:620">{{item[0]}} <text class="tag">优先</text></view><view style="font-size:21rpx;color:var(--faint);margin-top:4rpx">{{item[2]}}</view></view>
    </view>

    <view class="blk" wx:if="{{d.aug.length}}"><text class="bt">心悟选择</text></view>
    <view wx:for="{{d.aug}}" wx:key="index" style="display:flex;gap:18rpx;padding:14rpx 4rpx">
      <view style="flex:none;width:40rpx;height:40rpx;border-radius:50%;border:1px solid rgba(169,134,67,.4);color:var(--gold-hi);font-size:21rpx;display:grid;place-items:center">{{index + 1}}</view>
      <view><view style="font-size:26rpx;font-weight:620">{{item[0]}}</view><view style="font-size:21rpx;color:var(--faint);margin-top:4rpx">{{item[1]}}</view></view>
    </view>

    <!-- 运营节奏:版块先预留,数据没补齐时给一行空态提示,不留白卡 -->
    <view class="blk"><text class="bt">运营节奏</text><text class="cnt">预留</text></view>
    <view class="card">
      <view class="beats" wx:if="{{d.beats.length}}">
        <view wx:for="{{d.beats}}" wx:key="index" class="li"><text class="tm">{{item[0]}}</text><text>{{item[1]}}</text></view>
      </view>
      <view wx:else class="beats-empty">暂无运营节奏 · 待补充（升人口 / 搜牌 / 成型节点）</view>
    </view>

    <view class="blk" wx:if="{{d.tip}}"><text class="bt">对局提示</text></view>
    <view wx:if="{{d.tip}}" style="font-size:25rpx;color:var(--dim);line-height:1.8">{{d.tip}}</view>
    <view hover-class="tap-dim" class="savebtn" bindtap="onShareUnit">生成分享卡片</view>
  </block>

  <!-- ============ 棋子详情 ============ -->
  <block wx:if="{{type === 'piece'}}">
    <view style="display:flex;gap:26rpx;align-items:center">
      <!-- 头像与图鉴列表同构:立绘 cover 头部优先裁剪;404 背景层不渲染,透出首字(不用 ava.main 金圈) -->
      <view class="ava" style="position:relative;overflow:hidden;background:{{d.color}}22;color:{{d.color}};border:3rpx solid {{d.color}}80;font-size:44rpx">
        <text>{{d.ch}}</text>
        <view wx:if="{{d.art}}" style="position:absolute;inset:0;background-image:url('{{d.art}}');background-size:cover;background-position:center 12%"></view>
      </view>
      <view>
        <view style="font-family:var(--serif);font-size:41rpx;font-weight:700">{{d.n}}</view>
        <view style="margin-top:8rpx"><text class="cost" style="color:{{d.color}}">{{d.c}}费</text> <text style="color:var(--faint);font-size:23rpx"> · {{d.job}}</text></view>
      </view>
    </view>
    <view class="blk"><text class="bt">羁绊</text></view>
    <view style="display:flex;gap:14rpx;flex-wrap:wrap">
      <view wx:for="{{d.bondsVM}}" wx:key="n" class="tag gold bond-tag" style="font-size:24rpx;padding:12rpx 24rpx" data-type="bond" data-name="{{item.n}}" bindtap="onJump">
        <view wx:if="{{item.icon}}" class="bt-ico" style="background-image:url('{{item.icon}}')"></view>{{item.n}}{{item.color ? " ✦" : ""}}
      </view>
    </view>
    <view class="blk" wx:if="{{d.skill && d.skill.d}}"><text class="bt">技能 · {{d.skill.n || "详情"}}</text></view>
    <!-- 技能正文包卡片模块(2026-10-29 用户拍板,与效果/心法同款);棋谱/升星静态节已按同日拍板移除 -->
    <view wx:if="{{d.skill && d.skill.d}}" class="card"><view style="font-size:26rpx;color:var(--dim);line-height:1.8">{{d.skill.d}}</view></view>
  </block>

  <!-- ============ 羁绊详情 ============ -->
  <block wx:if="{{type === 'bond'}}">
    <view style="display:flex;gap:26rpx;align-items:center">
      <!-- 头标:有徽记图→六边形白底槽(无描边,同图鉴列表);图 404 时透出首字 -->
    <view wx:if="{{d.icon}}" class="hex">
      <view class="hex-in" style="background:var(--card);font-size:44rpx;color:{{d.colorStr}}">
        {{d.ch}}
        <view class="hex-ico" style="background-image:url('{{d.icon}}')"></view>
      </view>
    </view>
    <view wx:else class="ava" style="background:{{d.color ? 'rgba(169,134,67,.15)' : 'rgba(47,109,168,.12)'}};color:{{d.colorStr}};border:3rpx solid {{d.colorStr}}66;font-size:44rpx">{{d.ch}}</view>
      <view>
        <view style="font-family:var(--serif);font-size:41rpx;font-weight:700">{{d.n}}</view>
        <view style="margin-top:8rpx;font-size:23rpx;color:var(--faint)">{{d.t}}羁绊 · 层数 {{d.lv}}{{d.color ? " · ✦ 彩色" : ""}}</view>
      </view>
    </view>
    <view class="blk"><text class="bt">效果</text></view>
    <view style="font-size:26rpx;color:var(--dim);line-height:1.8">{{d.d}}</view>
    <view class="blk"><text class="bt">羁绊棋子</text></view>
    <view class="card" wx:if="{{d.members.length}}">
      <view class="units">
        <view wx:for="{{d.members}}" wx:key="n" class="unit" data-type="piece" data-name="{{item.n}}" bindtap="onJump">
          <!-- overflow:hidden 让立绘层吃圆角;立绘 404 时不渲染,透出首字格 -->
          <view class="u-box" style="overflow:hidden;border-color:{{item.color}}9a;background:{{item.color}}17;color:{{item.color}}">
            <view class="inner">{{item.ch}}</view>
            <view wx:if="{{item.art}}" style="position:absolute;inset:0;background-image:url('{{item.art}}');background-size:cover;background-position:center 12%"></view>
          </view>
          <text class="u-name">{{item.n}}</text>
        </view>
      </view>
    </view>
    <view wx:else style="font-size:24rpx;color:var(--faint)">（演示数据待补）</view>
  </block>

  <!-- ============ 装备详情 ============ -->
  <block wx:if="{{type === 'equip'}}">
    <view style="display:flex;gap:26rpx;align-items:center">
      <!-- 头标:有图标图→圆角方槽(同图鉴列表),图 404 时透出首字;无图→首字圆徽 -->
      <view wx:if="{{d.icon}}" class="sq" style="font-size:44rpx;color:var(--gold-hi)">
        {{d.ch}}
        <view class="sq-ico" style="background-image:url('{{d.icon}}')"></view>
      </view>
      <view wx:else class="ava" style="background:rgba(169,134,67,.15);color:var(--gold-hi);border:3rpx solid rgba(169,134,67,.5);font-size:44rpx">{{d.ch}}</view>
      <view>
        <view style="font-family:var(--serif);font-size:41rpx;font-weight:700">{{d.n}}</view>
        <view style="margin-top:8rpx" wx:if="{{d.r}}"><text class="rar {{d.rcls}}">{{d.r}}</text></view>
      </view>
    </view>
    <view class="blk"><text class="bt">效果</text></view>
    <!-- 效果正文包卡片模块(2026-10-29 用户拍板,同心法);规矩静态卡已按同日拍板移除 -->
    <view class="card"><view style="font-size:26rpx;color:var(--dim);line-height:1.8">{{d.d}}</view></view>
    <view class="blk" wx:if="{{d.who}}"><text class="bt">推荐佩戴</text></view>
    <view wx:if="{{d.who}}" style="font-size:26rpx;color:var(--dim)">{{d.who}}</view>
  </block>

  <!-- ============ 心悟详情 ============ -->
  <block wx:if="{{type === 'augment'}}">
    <view style="display:flex;gap:26rpx;align-items:center">
      <!-- 头标:同装备,方槽+首字兜底 -->
      <view wx:if="{{d.icon}}" class="sq" style="font-size:44rpx;color:var(--gold-hi)">
        {{d.ch}}
        <view class="sq-ico" style="background-image:url('{{d.icon}}')"></view>
      </view>
      <view wx:else class="ava" style="background:rgba(169,134,67,.15);color:var(--gold-hi);border:3rpx solid rgba(169,134,67,.5);font-size:44rpx">{{d.ch}}</view>
      <view>
        <view style="font-family:var(--serif);font-size:41rpx;font-weight:700">{{d.n}}</view>
        <view style="margin-top:8rpx" wx:if="{{d.t}}"><text class="tag">{{d.t}}心悟</text></view>
      </view>
    </view>
    <view class="blk"><text class="bt">心法</text></view>
    <!-- 心法正文包卡片模块(2026-10-29 用户拍板);择法静态卡已按同日拍板移除 -->
    <view class="card"><view style="font-size:26rpx;color:var(--dim);line-height:1.8">{{d.d}}</view></view>
  </block>

  <view class="legal" wx:if="{{d}}">{{pack.legal}}</view>
</view>

<view class="page" wx:else>
  <view class="empty rise" style="margin-top:120rpx"><text class="k">未寻得此侠</text>内容可能随赛季更迭移入归档，或已在正式数据中更新名称</view>
  <view class="legal">{{pack.legal}}</view>
</view>
