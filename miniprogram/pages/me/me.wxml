<view class="page">
  <view class="me-head rise" style="text-align:center;padding:30rpx 0 10rpx">
    <view class="ava" style="width:118rpx;height:118rpx;margin:0 auto 18rpx;font-size:48rpx;background:rgba(169,134,67,.15);color:var(--gold-hi);border:3rpx solid rgba(169,134,67,.5)">侠</view>
    <view style="font-family:var(--serif);font-size:37rpx;letter-spacing:.06em">少侠请留步</view>
    <view style="font-size:22rpx;color:var(--faint);margin-top:8rpx">登录后云端同步我的阵容与收藏（占位）</view>
  </view>

  <button class="season-bar rise" bindtap="onSeasonBar">
    <text class="nm">{{season.id}} · {{season.name}}<text class="curbadge">{{season.current ? "当前赛季" : "已归档"}}</text></text>
    <text class="sw">切换赛季</text>
  </button>

  <view class="slider-seg rise">
    <view class="thumb" style="transform:{{thumbX}}"></view>
    <button class="opt {{seg === 'all' ? 'on' : ''}}" data-k="all" bindtap="onSeg">全部阵容</button>
    <button class="opt {{seg === 'cur' ? 'on' : ''}}" data-k="cur" bindtap="onSeg">当前赛季</button>
  </view>

  <view class="blk">
    <text class="bt">我的阵容</text><text class="cnt">{{sims.length}} 套</text>
    <text style="margin-left:auto;font-size:20rpx;color:var(--faint)">摆棋页「保存到我的」生成</text>
  </view>
  <view wx:for="{{sims}}" wx:key="idx" class="card rise">
    <view style="display:flex;align-items:center;gap:14rpx">
      <text style="font-family:var(--serif);font-size:31rpx;font-weight:700">{{item.name}}</text>
      <text class="tag">{{item.season}}</text>
      <text style="margin-left:auto;color:var(--faint)" data-idx="{{item.idx}}" bindtap="onDelSim">🗑</text>
    </view>
    <view style="display:grid;grid-template-columns:repeat(8,1fr);gap:9rpx;margin-top:20rpx">
      <view wx:for="{{item.units}}" wx:for-item="u" wx:key="n" class="u-mini" style="border-color:{{u.color}}66;color:{{u.color}}">
        <view class="inner">{{u.ch}}</view>
        <view wx:if="{{u.isMain}}" class="cmark">C</view>
      </view>
    </view>
    <view style="margin-top:18rpx;display:flex;align-items:center;gap:10rpx;flex-wrap:wrap">
      <text class="tag">{{item.count}} 枚 · 费用 {{item.cost}}</text>
      <text wx:if="{{item.main}}" class="tag gold">主C {{item.main}}</text>
      <button class="chip sm" style="margin-left:auto" data-idx="{{item.idx}}" bindtap="onLoadSim">载入摆棋</button>
    </view>
  </view>
  <view wx:if="{{!sims.length}}" class="empty rise"><text class="k">尚无自己的阵容</text>在摆棋页摆好棋子后点「保存到我的」，棋盘快照会收进这里</view>

  <view class="blk">
    <text class="bt">我的收藏</text><text class="cnt">{{favs.length}} 套</text>
    <text style="margin-left:auto;font-size:20rpx;color:var(--faint)">阵容推荐页点 ☆ 收藏</text>
  </view>
  <view wx:for="{{favs}}" wx:key="name" class="card rise" data-name="{{item.name}}" bindtap="onOpenFav">
    <view style="display:flex;align-items:center;gap:14rpx">
      <text style="font-family:var(--serif);font-size:31rpx;font-weight:700">{{item.name}}</text>
      <text class="tier {{item.tier}}">{{item.tier}}</text>
      <text class="tag">{{item.season}}</text>
      <text style="margin-left:auto;color:var(--faint)" catchtap="onDelFav" data-name="{{item.name}}">🗑</text>
    </view>
    <view style="display:grid;grid-template-columns:repeat(8,1fr);gap:9rpx;margin-top:20rpx">
      <view wx:for="{{item.units}}" wx:for-item="u" wx:key="n" class="u-mini" style="border-color:{{u.color}}66;color:{{u.color}}">
        <view class="inner">{{u.ch}}</view>
        <view wx:if="{{u.isMain}}" class="cmark">C</view>
      </view>
    </view>
    <view style="margin-top:18rpx">
      <text wx:for="{{item.traits}}" wx:for-item="t" wx:key="n" class="tag {{t.color ? 'gold' : ''}}">{{t.n}} {{t.count}}</text>
    </view>
  </view>
  <view wx:if="{{!favs.length}}" class="empty rise"><text class="k">暂无收藏</text>看阵容推荐时点 ☆，把别人的阵容收进这里随时翻看</view>

  <view class="sec-head"><text class="h2">关于</text></view>
  <view class="card" style="font-size:25rpx;color:var(--dim);line-height:1.8">
    本工具为非官方玩家工具，与网易无关联。当前展示为原型演示数据，正式版数据来自官方公告与社区整理，随赛季云端热更新、赛季更迭后可回看归档数据。
  </view>
  <view class="legal">{{pack.legal}}</view>
</view>

<view class="scrim {{sheetOn ? 'on' : ''}}" bindtap="onScrim"></view>
<view class="sheet {{sheetOn ? 'on' : ''}}">
  <view class="grab"></view>
  <view class="h3">赛季更迭</view>
  <view class="sp">每个赛季棋子与羁绊会更换；归档赛季数据只读可查</view>
  <button wx:for="{{seasons}}" wx:key="id" class="season-item {{season.id === item.id ? 'on' : ''}}" data-id="{{item.id}}" bindtap="onPickSeason" style="text-align:left">
    <view class="info" style="flex:1">
      <view class="nm" style="font-size:30rpx;font-weight:650">{{item.id}} · {{item.name}}</view>
      <view class="rg" style="font-size:21rpx;color:#8A8375;margin-top:4rpx">{{item.range}}</view>
    </view>
    <text class="meta" style="font-size:23rpx;color:#8A8375">{{season.id === item.id ? "当前赛季" : "切换"}}</text>
  </button>
</view>
