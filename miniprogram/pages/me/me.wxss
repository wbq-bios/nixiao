/* 我的:个人信息 / 数据概览 / 阵容码 / 功能入口 / 赛季胶囊 */
.me { padding-top: 8rpx; }

/* ---- 个人信息 ---- */
.mhead { display: flex; align-items: center; gap: 20rpx; padding: 6rpx 0 4rpx; }
.mava {
  position: relative; flex: none; width: 132rpx; height: 132rpx; border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #F7EAD0, #D9C18C);
  border: 4rpx solid #C9A24B; display: grid; place-items: center;
}
.mava-ch { font-family: var(--serif); font-size: 58rpx; font-weight: 700; color: #8A6A2F; }
.mlv {
  position: absolute; left: 50%; bottom: -10rpx; transform: translateX(-50%);
  padding: 2rpx 12rpx; border-radius: 99rpx; border: 2rpx solid var(--card);
  background: linear-gradient(135deg, #D8B56A, #A98643); color: #FFF9EE; font-size: 18rpx; font-weight: 700;
}
.mbody { flex: 1; min-width: 0; }
.mname { display: flex; align-items: center; gap: 8rpx; font-family: var(--serif); font-size: 36rpx; font-weight: 700; }
.msex { font-size: 26rpx; color: #4A7FB5; }
.msig { margin-top: 8rpx; font-size: 22rpx; color: var(--faint); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.mchev { margin-left: 6rpx; color: var(--faint); }
.mid { margin-top: 8rpx; font-size: 21rpx; color: var(--faint); }
.mcopy { margin-left: 10rpx; font-size: 22rpx; color: var(--dim); }
/* 顶部赛季下拉(取代原设置齿轮) */
.mseason {
  flex: none; display: inline-flex; align-items: center; gap: 6rpx; padding: 10rpx 18rpx;
  border-radius: 99rpx; background: var(--gold-dim); color: var(--gold-hi);
  font-size: 22rpx; font-weight: 650;
}
.msarrow { font-size: 15rpx; }

/* ---- 数据概览(四列等分,竖细线分隔) ---- */
.mstats {
  margin-top: 20rpx; display: grid; grid-template-columns: repeat(3, 1fr);
  background: var(--card); border: 1px solid var(--line); border-radius: 24rpx; padding: 22rpx 0;
}
.ms { position: relative; display: flex; flex-direction: column; align-items: center; gap: 6rpx; }
.ms + .ms::before { content: ""; position: absolute; left: 0; top: 12rpx; bottom: 12rpx; width: 1px; background: var(--line); }
.msn { font-family: var(--serif); font-size: 38rpx; font-weight: 700; color: var(--txt); }
.msl { font-size: 19rpx; color: var(--faint); }

/* ---- 阵容码入口 ---- */
.mcode {
  margin-top: 18rpx; display: flex; align-items: center; gap: 18rpx; padding: 24rpx;
  border-radius: 24rpx; background: linear-gradient(100deg, #A98643 0%, #C9A24B 55%, #D8B56A 100%);
  color: #FFF9EE; box-shadow: 0 14rpx 30rpx -18rpx rgba(143, 111, 47, .8);
}
.mcode-ico {
  flex: none; width: 64rpx; height: 64rpx; border-radius: 16rpx; display: grid; place-items: center;
  background: rgba(255, 249, 238, .18); border: 1px solid rgba(255, 249, 238, .35);
  font-family: var(--serif); font-size: 32rpx; font-weight: 700;
}
.mcode-img { width: 38rpx; height: 38rpx; display: block; }
.mcode-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.mcode-t { font-family: var(--serif); font-size: 31rpx; font-weight: 700; }
.mcode-d { font-size: 20rpx; opacity: .85; }
.mcode-go { font-size: 32rpx; opacity: .8; }

/* ---- 功能入口 ---- */
.mmenu { margin-top: 18rpx; background: var(--card); border: 1px solid var(--line); border-radius: 24rpx; overflow: hidden; }
.mrow { display: flex; align-items: center; gap: 18rpx; padding: 22rpx; border-bottom: 1px solid var(--line); }
.mrow.last { border-bottom: none; }
.mrow-ico {
  flex: none; width: 56rpx; height: 56rpx; border-radius: 14rpx; display: grid; place-items: center;
  background: var(--gold-dim); color: var(--gold-hi); font-family: var(--serif); font-size: 27rpx; font-weight: 700;
}
.mrow-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.mrow-img { width: 40rpx; height: 40rpx; display: block; }
.mrow-t { font-size: 27rpx; font-weight: 650; color: var(--txt); }
.mrow-d { font-size: 19rpx; color: var(--faint); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.mrow-go { flex: none; color: var(--faint); font-size: 28rpx; }
.mbtn {
  flex: none; padding: 12rpx 24rpx; border-radius: 99rpx;
  background: var(--gold); color: #FFF9EE; font-size: 22rpx; font-weight: 700;
}

/* ---- 分区标题上的赛季胶囊 ---- */
.season-chip {
  margin-left: auto; display: inline-flex; align-items: center; padding: 6rpx 16rpx;
  border-radius: 99rpx; background: var(--gold-dim); color: var(--gold-hi); font-size: 20rpx; font-weight: 650;
}
.sc-arrow { margin-left: 6rpx; font-size: 15rpx; }

/* ---- 弹层里的正文 ---- */
.mabout { font-size: 24rpx; color: var(--dim); line-height: 1.8; }
.mlegal { margin-top: 16rpx; font-size: 20rpx; color: var(--faint); line-height: 1.7; }
.setrow { display: flex; align-items: center; gap: 12rpx; padding: 22rpx 6rpx; border-bottom: 1px solid var(--line); }
.setrow-t { font-size: 26rpx; color: var(--txt); }
.setrow-d { margin-left: auto; font-size: 21rpx; color: var(--faint); }
.setrow-go { color: var(--faint); }

/* ---- 二级"详情页"浮层 ---- */
.mpage {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 120;
  display: flex; flex-direction: column; background: var(--bg);
  transform: translateX(100%); transition: transform .22s ease;
}
.mpage.on { transform: translateX(0); }
.mpage-hd { flex: none; display: flex; align-items: center; gap: 8rpx; padding: 20rpx 24rpx 10rpx; }
.mpage-back { font-size: 46rpx; line-height: 1; color: var(--dim); padding: 0 12rpx 6rpx; }
.mpage-title { font-family: var(--serif); font-size: 34rpx; font-weight: 700; letter-spacing: .04em; }
.mpage-season { margin-left: 12rpx; padding: 2rpx 12rpx; border-radius: 99rpx; background: var(--gold-dim); color: var(--gold-hi); font-size: 18rpx; font-weight: 650; }
.mpage-cnt { margin-left: auto; font-size: 21rpx; color: var(--faint); }
.mpage-body { flex: 1; min-height: 0; padding: 6rpx 32rpx 40rpx; box-sizing: border-box; }
