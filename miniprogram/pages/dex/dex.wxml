<view class="page">
  <view class="blk" style="margin-top:4rpx;position:relative">
    <text class="bt">万象图鉴</text>
    <text class="cnt">{{season.id}} · {{season.name}}</text>
    <text class="demo-badge" style="position:static;margin-left:auto">内测数据</text>
  </view>

  <view class="search">
    <input placeholder="搜索棋子 / 羁绊 / 装备 / 心悟" value="{{q}}" bindinput="onQ" />
  </view>

  <view class="seg">
    <button wx:for="{{segs}}" wx:key="k" class="opt {{seg === item.k ? 'on' : ''}}" data-k="{{item.k}}" bindtap="onSeg">{{item.l}}</button>
  </view>

  <view wx:if="{{seg === 'piece'}}" class="chiprow">
    <button wx:for="{{costs}}" wx:key="*this" class="chip sm {{cost === item ? 'on' : ''}}" data-v="{{item}}" bindtap="onCost">{{item === 0 ? "全部" : item + "费"}}</button>
  </view>

  <view wx:for="{{list}}" wx:key="key" class="card rise" style="display:flex;align-items:center;gap:22rpx" data-key="{{item.key}}" bindtap="onOpen">
    <view class="ava" style="position:relative;overflow:hidden;background:{{item.color || 'var(--gold-dim)'}}22;color:{{item.color || 'var(--gold-hi)'}};border:3rpx solid {{item.color || 'rgba(169,134,67,.5)'}}80">
      <image wx:if="{{item.art}}" src="{{item.art}}" mode="aspectFill" style="position:absolute;inset:0;width:100%;height:100%" binderror="onArtErr" data-key="{{item.key}}" data-idx="{{index}}" />
      <text wx:else>{{item.ch}}</text>
    </view>
    <view style="flex:1;min-width:0">
      <view style="display:flex;align-items:center;gap:12rpx">
        <text style="font-size:29rpx;font-weight:650">{{item.n}}</text>
        <block wx:if="{{item.cost}}"><text class="cost" style="color:{{item.color}}">{{item.cost}}费</text></block>
        <block wx:elif="{{item.lv}}"><text class="tag gold">{{item.lv}}</text><text wx:if="{{item.color}}" class="tag gold">✦ 彩色</text></block>
        <block wx:elif="{{item.r}}"><text class="rar {{item.rcls}}">{{item.r}}</text></block>
        <block wx:elif="{{item.t}}"><text class="tag">{{item.t}}</text></block>
      </view>
      <view style="font-size:22rpx;color:var(--faint);margin-top:8rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{item.desc}}</view>
    </view>
    <text style="color:var(--faint)">›</text>
  </view>

  <view wx:if="{{!list.length}}" class="empty"><text class="k">未寻得此侠</text>换个关键字试试</view>
  <view wx:if="{{seg === 'piece'}}" class="ad"><text class="t1">广 告 位 · 预 留</text><text class="t2">banner · 可配置开关</text></view>
</view>
